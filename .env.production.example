# Waypoint Production Environment Configuration
# Copy this file to .env.production on your server:
#   cp .env.production.example .env.production

# 1. Your domain name (or public server IP during initial setup)
DOMAIN=waypoint.example.com

# 2. Email for Let's Encrypt SSL/TLS certificate registration & renewal alerts
ACME_EMAIL=admin@example.com

# 3. Strong PostgreSQL Database Password
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_random_db_password

# 4. 64-character hex JWT Secret Key (required by FastAPI backend; no default in code!)
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_random_64_character_hex_secret_key
